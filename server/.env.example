# Copy to server/.env (docker compose loads it automatically). All values are optional.

PORT=3001
DATABASE_PATH=./carethread.db

# Streamable HTTP mode: "false" = MCP sessions (default), "true" = stateless, a fresh server per POST
# (use stateless behind a load balancer or on hosts that don't pin requests to one instance)
MCP_STATELESS=false

# Comma-separated Host header allow-list; enables DNS-rebinding protection when set
ALLOWED_HOSTS=

# Amazon Bedrock for the ask_care_log tool. Off by default: care-log text is only sent to Bedrock when "on",
# and never for a circle in privacy mode. Credentials come from the standard AWS chain (env, profile, task role).
CARETHREAD_BEDROCK=off
AWS_REGION=us-east-1
# Any Bedrock model id or inference profile your account can invoke with the Converse API
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_TIMEOUT_MS=6000
